{
  "name": "geneforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GeneForge — espace local de biologie moléculaire",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:e2e": "node --disable-warning=ExperimentalWarning tests/e2e.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
